# ==============================================================================
# GITIGNORE - PROJETO ELEICOES / R
# ==============================================================================

# Arquivos temporários e de sessão do R / RStudio
.RData
.RDataTmp
.Rhistory
**/.Rhistory
**/.Rproj.user/
tst.parquet

# Camada 01_raw (Bronze) - Dados brutos e zips originais (~3.3 GB)
tse/data/01_raw/

# Camada 02_silver (Silver) - Dados tratados volumosos (>100MB por arquivo)
tse/data/02_silver/csv/*.csv
tse/data/02_silver/parquet/*.parquet

# Preservar dicionários de dados e metadados gerados pelo catálogo
!tse/data/**/README.md
!tse/data/**/metadata.json
